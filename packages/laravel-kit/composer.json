{
    "name": "okjt/laravel-kit",
    "description": "The server half of the OKJT kit: workspaces and roles, version history, and the middleware that enforces them, for Laravel 12 APIs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "pragmarx/google2fa": "^8.0|^9.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "laravel/sanctum": "^4.0",
        "bacon/bacon-qr-code": "^3.0"
    },
    "autoload": {
        "psr-4": { "Okjt\\Kit\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Okjt\\Kit\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": { "providers": ["Okjt\\Kit\\KitServiceProvider"] }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
