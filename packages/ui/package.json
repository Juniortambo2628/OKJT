{
  "name": "@okjt/ui",
  "version": "0.1.0",
  "description": "Theme tokens and shared building blocks (buttons, dialogs, menus, feedback, permissions) for OKJTech sites and dashboards",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juniortambo2628/OKJT.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": "./dist/index.js",
    "./theme": "./src/theme.js",
    "./tools/style-snapshot": "./tools/style-snapshot.mjs"
  },
  "bin": {
